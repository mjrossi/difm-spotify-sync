# Container defaults. Committed — no secrets here.
#
# This is the dotenv half of the mise layering, and it mirrors it:
#
#   mise.toml              ->  .env.defaults          (this file)
#   mise.<env>.toml        ->  .env.<env>
#   mise.local.toml        ->  .env.local             (gitignored)
#   mise.<env>.local.toml  ->  .env.<env>.local       (gitignored)
#
# compose.yaml loads all four in that order, later winning, and picks the
# <env> layer from MISE_ENV — the same switch mise reads, so one variable
# steers both. Unset means production, matching mise.toml's role.
#
# A few non-secret defaults (LOG_FORMAT, LOG_LEVEL, INTERVAL) are stated
# both here and in mise.toml, and that duplication is deliberate rather
# than an oversight. Loading this file into mise as well would drag
# DIFMSYNC_HTTP_ADDR=0.0.0.0 into every local `just` run, which is a
# container fact and wrong on a workstation. Two short lists that can
# drift is the better trade against one list that is wrong half the time
# — but if you change a default in one, change it in the other.
#
# The reverse also holds: DIFMSYNC_HTTP_ADDR, DIFMSYNC_AUTH_HTTP_ADDR and
# DIFMSYNC_SPOTIFY_REDIRECT_URL are here and deliberately *not* in
# mise.toml. All three name ports the container publishes, which is a
# deployment fact; on a workstation the first two would bind interfaces
# nobody asked for and the third would point `just auth` at a listener
# that is not running.
#
# Two settings deliberately are NOT here: DIFMSYNC_DB_PATH and
# DIFMSYNC_AUTH_BIND stay pinned in compose.yaml's `environment:` block,
# which overrides every layer below. They are facts about running inside
# this container rather than preferences, and an override would break the
# deployment in ways that are tedious to diagnose. See the comments there.

# JSON for the deployed daemon; a log collector can parse it.
DIFMSYNC_LOG_FORMAT=json
DIFMSYNC_LOG_LEVEL=info

# How often the internal ticker runs a pass. Not cron — nothing external
# triggers a sync, so this is the whole schedule.
DIFMSYNC_INTERVAL=15m

# Read-only status endpoints, reachable from the LAN so a dashboard
# (Uptime Kuma, Homepage) can poll them. Safe to expose unauthenticated
# only because they carry no secrets and cannot change anything — see
# internal/status.
#
# The host half must stay 0.0.0.0: a published port forwards to the
# container's eth0 address, not its loopback, so 127.0.0.1 here would be
# unreachable from the host. The port is yours to change — but change the
# `ports:` mapping in compose.yaml with it, or the two disagree and the
# endpoint silently stops answering.
#
# The startup log will say `addr=[::]:3436` rather than 0.0.0.0. That is
# not the setting being ignored: Go turns a wildcard listen into a
# dual-stack socket where IPv6 is available, which accepts IPv4 too and
# reports itself by the IPv6 wildcard. On a host without IPv6 the same
# line reads 0.0.0.0.
DIFMSYNC_HTTP_ADDR=0.0.0.0:3436

# Where the one-time Spotify consent flow is served while there is no
# refresh token. Set, the daemon waits with a listener instead of exiting
# — which under `restart: unless-stopped` was a crash loop rather than a
# prompt. Unset, the old behavior returns: the daemon exits and tells you
# to run `difmsync auth`.
#
# The port is published to the host's loopback only; whatever terminates
# TLS in front of it (tailscale serve, a reverse proxy) is what makes it
# reachable, and DIFMSYNC_SPOTIFY_REDIRECT_URL is what tells the daemon
# the public origin to print in the log. Consent is guarded by a nonce
# generated at startup and logged once; the port alone is not enough.
DIFMSYNC_AUTH_HTTP_ADDR=0.0.0.0:3437

# Where Spotify sends the browser back — and, since both consent routes
# and the logged start URL are derived from it, the origin an operator
# clicks.
#
# Stated here rather than left to the binary's own default, which is
# 127.0.0.1:8888: that is the `auth` subcommand's workstation port and
# nothing in this compose file publishes it, so the one click the
# deployment asks for went to a refused connection. Set to the consent
# port above, the flow works from a browser on the host with nothing in
# front of it, because Spotify accepts a loopback literal over plain
# HTTP.
#
# Reaching it from any other machine needs an HTTPS origin, which means
# something terminating TLS in front — see the Tailscale section of
# docs/deploy.md, and override this in .env.local when you do. Whatever
# it ends up as must be registered in the Spotify dashboard verbatim.
DIFMSYNC_SPOTIFY_REDIRECT_URL=http://127.0.0.1:3437/callback

# How stale the last clean pass may be before /healthz and
# `status --check` report unhealthy. Three ticks of the interval above,
# so one missed pass is tolerated and two are not.
DIFMSYNC_STATUS_MAX_AGE=45m
