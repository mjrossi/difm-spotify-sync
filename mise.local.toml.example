# Copy to mise.local.toml (gitignored) for machine-specific secrets.
# Capture DIFMSYNC_API_KEY / DIFMSYNC_MEMBER_ID per docs/difm-api.md.
[env]
DIFMSYNC_API_KEY = ""
DIFMSYNC_MEMBER_ID = ""
DIFMSYNC_SPOTIFY_CLIENT_ID = ""
DIFMSYNC_SPOTIFY_CLIENT_SECRET = ""
DIFMSYNC_PLAYLIST_ID = ""

# Must match a redirect URI registered on the Spotify app exactly. Both
# the `auth` listener's port and its path are derived from this.
DIFMSYNC_SPOTIFY_REDIRECT_URL = "http://127.0.0.1:8888/callback"

# Only needed when running `auth` inside a container, where a published
# port forwards to eth0 rather than loopback. compose.yaml sets it for
# you; leave it empty for local runs.
DIFMSYNC_AUTH_BIND = ""
