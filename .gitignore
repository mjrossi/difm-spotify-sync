# machine-specific overrides (may contain credentials).
#
# There is no committed dotenv layer any more — non-secret defaults live in
# the Dockerfile's ENV block, and .env.local is the only dotenv file, held
# by a checkout and holding secrets alone. A bare .env is ignored too:
# nothing reads it, but Compose picks one up automatically for ${...}
# interpolation, so a stray file should never reach the repo.
mise.local.toml
mise.*.local.toml
.env
.env.local
.env.*.local

# local state
tmp/
*.db
*.db-shm
*.db-wal

# build output
bin/
