# https://editorconfig.org — most editors pick this up automatically.
# Go's tooling enforces tabs separately (gofmt); this file is mainly for
# the SQL/YAML/Markdown sides so contributors don't fight their editors
# over indentation when adding a tooling change.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{json,yaml,yml,md,toml}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

# justfile recipes use 4-space indentation (the project convention);
# `set shell := ["bash", ...]` runs each recipe line through bash, and
# spaces avoid the Makefile-style tab gotcha if a recipe ever grows a
# heredoc.
[justfile]
indent_style = space
indent_size = 4
