# Container overrides for MISE_ENV=development. Committed — no secrets.
#
# Mirrors mise.development.toml, so a container started with
# MISE_ENV=development logs the same way a local `just` run does.
#
#   MISE_ENV=development docker compose up -d
DIFMSYNC_LOG_FORMAT=text
DIFMSYNC_LOG_LEVEL=debug

# Tighter loop so a test pass lands in a couple of minutes rather than
# fifteen. The engine clamps anything below 1m.
DIFMSYNC_INTERVAL=2m
